<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      * {
        margin: 0;
        padding: 0;
      }
      .nav-bar {
        background-color: rgb(74, 74, 74);
        color: white;
      }
      .nav-bar nav{
        height: 7vh;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .nav-bar nav ul {
        display: flex;
        gap: 30px;
        list-style: none;
      }
    </style>
  </head>
  <body>
    <div class="nav-bar">
      <nav>
        <ul>
          <li>Home</li>
          <li>About</li>
          <li>Resources</li>
          <li>Contact</li>
        </ul>
      </nav>
    </div>
  </body>
</html>
