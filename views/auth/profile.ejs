<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

<%- include('../header') %>

<div class="profile-container">

    <!-- Top Card -->
    <div class="profile-header">
        <div class="avatar">
            <%= user.name.charAt(0).toUpperCase() %>
        </div>

        <div class="user-details">
            <h2><%= user.name %></h2>
            <p>📧 <%= user.email %></p>
            <p>📅 Member since <%= new Date(user.createdAt).toLocaleDateString() %></p>
        </div>
    </div>

    <!-- Stats -->
    <div class="stats">

        <div class="stat-box">
            <h3><%= user.links.length %></h3>
            <p>LINKS CREATED</p>
        </div>

        <div class="stat-box">
            <h3>0</h3>
            <p>TOTAL CLICKS</p>
        </div>

        <div class="stat-box">
            <h3>
                <%= user.lastLogin ? "Today" : "N/A" %>
            </h3>
            <p>LAST ACTIVE</p>
        </div>

    </div>
    <!-- Email Verification -->
<div class="email-verification">

    <p>
        📧 Email Status: 
        <% if (user.isEmailValid) { %>
            <span style="color: green; font-weight: bold;">Verified ✅</span>
        <% } else { %>
            <span style="color: red; font-weight: bold;">Not Verified ❌</span>
            <a href="/verify-email" class="btn verify" >Verify Now</a>
        <% } %>
    </p>

</div> 
    <!-- Actions -->
    <div class="actions">

        <a href="#" class="btn edit">✏️ Edit Profile</a>

        <a href="/forgot-password" class="btn password">🔑 Forgot Password</a>

        <a href="/logout" class="btn logout">⏻ Logout</a>

    </div>

</div>

</body>
</html>