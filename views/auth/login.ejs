<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <link rel="stylesheet" href="/style.css" />
  </head>

  <body>
    <%- include('../header') %>

    <div class="auth-wrapper">
      <div class="auth-card">
        <h1 class="auth-title">Welcome Back</h1>
        <p class="auth-subtitle">Login to your account</p>

        <form action="/login" method="post" class="auth-form">
          <div class="input-group">
            <label for="email">Email</label>
            <input
              type="email"
              name="email"
              id="email"
              placeholder="Enter your email"
              required
            />
          </div>

          <div class="input-group password-field">
            <label for="password">Password</label>
            <input
              type="password"
              name="password"
              id="password"
              placeholder="Enter your password"
              required
            />
            <span class="toggle-password">🙈</span>
          </div>

          <% if(errors && errors.length > 0) { %>
          <div class="error-box">
            <% errors.forEach((error) => { %> 
            <p class="flash-error"><%= error %></p>
          <% }) %>
          </div>
          <% } %>

          <button type="submit" class="auth-btn">Login</button>
        </form>
          <!-- Forgot Password -->
        <div class="forgot-password">
           <a href="/reset-password">Forgot Password?</a>
        </div>

        <!-- OR Divider -->
        <div style="text-align:center; margin:15px 0; color:gray;">OR</div>

        <!-- Google Login -->
        <a href="/google" class="google-btn">
  <svg width="20" height="20" viewBox="0 0 48 48" style="vertical-align: middle; margin-right: 8px;">
    <path fill="#EA4335" d="M24 9.5c3.54 0 6.73 1.22 9.24 3.6l6.89-6.89C35.9 2.27 30.38 0 24 0 14.61 0 6.36 5.48 2.48 13.44l8.04 6.24C12.48 13.07 17.74 9.5 24 9.5z"/>
    <path fill="#4285F4" d="M46.5 24.5c0-1.64-.15-3.22-.43-4.74H24v9.01h12.7c-.55 2.96-2.22 5.48-4.74 7.18l7.32 5.68C43.98 37.3 46.5 31.36 46.5 24.5z"/>
    <path fill="#FBBC05" d="M10.52 28.68A14.5 14.5 0 0 1 9.5 24c0-1.62.28-3.2.78-4.68l-8.04-6.24A23.98 23.98 0 0 0 0 24c0 3.87.92 7.52 2.56 10.76l7.96-6.08z"/>
    <path fill="#34A853" d="M24 48c6.48 0 11.92-2.13 15.89-5.77l-7.32-5.68c-2.03 1.36-4.64 2.16-8.57 2.16-6.26 0-11.52-3.57-13.48-8.68l-7.96 6.08C6.36 42.52 14.61 48 24 48z"/>
  </svg>
  Login with Google
</a>

<!-- GitHub Login -->
<a href="/github" class="github-btn">
  <svg height="20" viewBox="0 0 16 16" width="20" style="margin-right: 8px;">
    <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 
    0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 
    1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 
    0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 
    0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 
    2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 
    0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
  </svg>
  Login with GitHub
</a>
      
        <p class="auth-footer">
          Don't have an account?
          <a href="/registration">Register</a>
        </p>
      </div>
    </div>
    <script>
document.querySelectorAll(".toggle-password").forEach((eye) => {
  eye.addEventListener("click", () => {
    const input = eye.previousElementSibling;

    // toggle password visibility
    const isPassword = input.type === "password";
    input.type = isPassword ? "text" : "password";

    // icon change
    eye.textContent = isPassword ? "👁️" : "🙈";

    // animation trigger
    eye.classList.add("active");
    setTimeout(() => {
      eye.classList.remove("active");
    }, 400);
  });
});
</script>
  </body>
</html>