<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

<%- include('header') %>

<div class="main-wrapper">

  <div class="shortener-card">

    <% if(user) { %>
      <p class="status success">You are Logged in</p>
      <h4 style="margin: 12px 0px;">Hi <%= name %>,</h4>
    <% } else { %>
      <p class="status warning">You are not logged in</p>
    <% } %>

    <form action="/" method="post" class="shortener-form">

        <div class="input-group">
            <label for="enterurl">Enter URL</label>
            <input type="url" name="enterurl" id="enterurl" placeholder="https://example.com" required>
        </div>

        <div class="input-group">
            <label for="shorturl">Custom Short URL (Optional)</label>
            <input type="text" name="shorturl" id="shorturl" placeholder="custom-name">
        </div>

        <% if(errors && errors.length > 0) { %>
          <div class="error-box">
            <% errors.forEach((error) => { %> 
            <p class="flash-error"><%= error %></p>
          <% }) %>
          </div>
          <% } %>
          
        <button type="submit" id="submitbtn" class="primary-btn">
            Shorten URL
        </button>

    </form>

  </div>


  <div class="links-card">

    <h2 class="links-title">Shortened URLs</h2>

    <ul class="links-list">

      <% links.forEach((item) => { %>

        <li class="link-item">
          <div class="info">
          <div class="short-link">
            <a href="/<%= item.shortCode %>" target="_blank">
              <%= host %>/<%= item.shortCode %>
            </a>
          </div>
          <div class="original-link">
            -> <%= item.url %>
          </div>
        
          <p class="url-summary" id="summary-<%= item.id %>">
            <% if(!item.summary) { %>
              <span class="skeleton">Generating Response....</span>
            <% } else { %>
              <%= item.summary %>
            <% } %>
          </p>

          </div>
          
          <div class="edit-link">
            <a href="/edit/<%= item.id %>" class="edit-btn">✏️</a>
              <form action="/delete/<%= item.id %>" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete?')">
                <button type="submit" style="border:none; background:none; cursor:pointer; padding: 0px 5px;">
                  🗑️
                </button>
              </form>
          </div>
        </li>

      <% }) %>

    </ul>

  </div>

  <div class="pagination-in-links">
    <% if(totalPages > 1) { %>
      <% if(currentPage > 1) { %>
        <a href="?page=<%= currentPage - 1 %>"><button class="page-btn">Previous</button></a>
      <% } else { %>
          <button class="page-btn disabled" disabled>Previous</button>
      <% } %>


     <% 
     let startPage = Math.max(1, currentPage - 2);
     let endPage = Math.min(totalPages, currentPage + 2); 
     %>

     <%# Always show first page %>
     <% if(startPage>1) { %>
      <a href="?page=1"><button>1</button></a>
      <% if(startPage>2) { %>
        <button>...</button>
      <% } %>
    <% } %>

     <% for(let i = startPage; i<= endPage; i++) { %>
      <% if(i === currentPage) { %>
        <button class="active"><%= i %></button>
      <% } else { %>
        <a href="?page=<%= i %>"><button><%= i %></button></a>
      <% } %>
     <% } %>

      <%# Always show last page %>
     <% if(endPage<totalPages) { %>
      <% if(endPage<totalPages-1) { %>
        <button>...</button>
      <% } %>
      <a href="?page=<%=totalPages%>"><button><%=totalPages%></button></a>
    <% } %>

      <% if(currentPage < totalPages) { %>
        <a href="?page=<%= currentPage + 1 %>"><button class="page-btn">Next</button></a>
      <% } else { %>
        <button class="page-btn disabled" disabled>Next</button>
      <% } %>
    <% } %>
  </div>

</div>
<script>
const links = document.querySelectorAll("[id^='summary-']");

links.forEach((el) => {
  const id = el.id.split("-")[1];

  const interval = setInterval(async () => {
    const res = await fetch(`/summary/${id}`);
    const data = await res.json();

    if (data.summary) {
      el.innerHTML = data.summary;
      clearInterval(interval); // stop polling
    }
  }, 2000); // every 2 sec
});
</script>
</body>
</html>