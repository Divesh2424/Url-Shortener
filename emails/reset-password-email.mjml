i<mjml>
  <mj-head>
    <mj-title>Password Reset</mj-title>
    <mj-preview>Reset your password securely</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="16px" color="#333333" />
      <mj-button background-color="#3498db" color="white" border-radius="6px" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f4f6f9">

    <!-- Wrapper should be here -->
    <mj-wrapper padding="20px">

      <mj-section background-color="#ffffff" border-radius="10px">
        <mj-column>

          <mj-text font-size="22px" font-weight="bold" align="center">
            🔐 Reset Your Password
          </mj-text>

          <mj-text align="center" color="#555555">
            We received a request to reset your password.
          </mj-text>

          <mj-text align="center" color="#555555">
            Click the button below to set a new password.
          </mj-text>

          <mj-button href="/<%= token %>">
            Reset Password
          </mj-button>

          <!-- ✅ ADDED DIRECT LINK -->
          <mj-text align="center" font-size="14px" color="#555555">
            If the button doesn't work, copy and paste this link: 
          </mj-text>

          <mj-text align="center" font-size="13px" color="#3498db">
            <a href="<%= link %>" style="color:#3498db; text-decoration:none;">
              <%= link %>
            </a>
          </mj-text>

          <mj-text align="center" color="#999999" font-size="13px">
            This link will expire in 15 minutes.
          </mj-text>

          <mj-divider />

          <mj-text align="center" font-size="13px" color="#999999">
            If you did not request this, you can safely ignore this email.
          </mj-text>

        </mj-column>
      </mj-section>

    </mj-wrapper>

  </mj-body>
</mjml>